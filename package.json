{
  "name": "workfluence",
  "version": "0.1.0",
  "private": true,
  "description": "금융 폐쇄망 내부용 위키·문서 협업 시스템",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:env": "tsx scripts/setup-env.ts",
    "check:env": "tsx scripts/check-env.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "dev": "pnpm --filter @workfluence/shared build && pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @workfluence/api start",
    "build:shared": "pnpm --filter @workfluence/shared build",
    "lint": "eslint .",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "test:cov": "pnpm build:shared && pnpm -r run test:cov",
    "test:e2e": "tsx scripts/e2e.ts",
    "verify:docs": "tsx scripts/verify-docs.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify:docs",
    "db:generate": "pnpm --filter @workfluence/api db:generate",
    "db:migrate": "pnpm build:shared && pnpm --filter @workfluence/api db:migrate",
    "db:seed": "pnpm build:shared && pnpm --filter @workfluence/api db:seed",
    "search:reindex": "pnpm build:shared && tsx scripts/reindex.ts",
    "trash:purge": "pnpm build:shared && tsx scripts/trash-purge.ts",
    "audit:purge": "pnpm build:shared && tsx scripts/audit-purge.ts",
    "licenses:check": "tsx scripts/check-licenses.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "argon2": "^0.45.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "pg": "^8.16.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
