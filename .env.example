# workfluence 환경변수 — 모든 키는 WF_ 접두사.
# 스키마: packages/shared/src/env.ts, 설명: docs/P0_설계서_Foundation.md 1.1절
# 이 파일의 키 집합과 스키마의 키 집합이 같아야 한다 (테스트가 강제, FR-015).
# 실제 값은 .env(커밋 금지)에. 여기는 placeholder만 (CLAUDE.md 12.3절)

# 실행 환경: development | test | production
WF_ENV=development
WF_PORT=3000
WF_LOG_LEVEL=info

# PostgreSQL. 개발은 임베디드 PG(pnpm dev:db)가 .local/pgdata에서 아래 포트로 뜬다
WF_DATABASE_URL=postgres://workfluence:workfluence@127.0.0.1:5433/workfluence
WF_DATABASE_URL_TEST=postgres://workfluence:workfluence@127.0.0.1:5433/workfluence_test
# 개발에서만 true 허용. 운영은 pnpm db:migrate를 배포 절차에서 명시 실행 (FR-014)
WF_DB_AUTO_MIGRATE=true

# 임베디드 PostgreSQL (pnpm dev:db). 데이터는 반드시 저장소 안 .local/ 아래 (CLAUDE.md 8.1절)
# 이 파일은 개발용이다. compose용 WF_PG_PASSWORD는 deploy/.env 에 따로 둔다 (CLAUDE.md 8.1절)
WF_PG_EMBEDDED_DIR=.local/pgdata
WF_PG_EMBEDDED_PORT=5433
WF_PG_EMBEDDED_PASSWORD=workfluence

# nginx 뒤에서 X-Forwarded-* 신뢰 (운영 true)
WF_TRUST_PROXY=false

# api가 빌드된 SPA를 함께 서빙할지 (운영 이미지 true, 개발은 Vite dev 서버)
WF_SERVE_WEB=false
WF_WEB_DIST=../web/dist
