# workfluence 환경변수 — 모든 키는 WF_ 접두사.
# 스키마: packages/shared/src/env.ts, 설명: docs/P0_설계서_Foundation.md 1.1절
# 이 파일의 키 집합과 스키마의 키 집합이 같아야 한다 (테스트가 강제, FR-015).
# 실제 값은 .env(커밋 금지)에. 여기는 placeholder만 (CLAUDE.md 12.3절)

# 실행 환경: development | test | production
WF_ENV=development
WF_PORT=3000
WF_LOG_LEVEL=info

# PostgreSQL. 개발은 임베디드 PG(pnpm dev:db)가 .local/pgdata에서 아래 포트로 뜬다
WF_DATABASE_URL=postgres://workfluence:workfluence@127.0.0.1:5433/workfluence
WF_DATABASE_URL_TEST=postgres://workfluence:workfluence@127.0.0.1:5433/workfluence_test
# 개발에서만 true 허용. 운영은 pnpm db:migrate를 배포 절차에서 명시 실행 (FR-014)
WF_DB_AUTO_MIGRATE=true

# 임베디드 PostgreSQL (pnpm dev:db). 데이터는 반드시 저장소 안 .local/ 아래 (CLAUDE.md 8.1절)
# 이 파일은 개발용이다. compose용 WF_PG_PASSWORD는 deploy/.env 에 따로 둔다 (CLAUDE.md 8.1절)
WF_PG_EMBEDDED_DIR=.local/pgdata
WF_PG_EMBEDDED_PORT=5433
WF_PG_EMBEDDED_PASSWORD=workfluence

# nginx 뒤에서 X-Forwarded-* 신뢰 (운영 true)
WF_TRUST_PROXY=false

# api가 빌드된 SPA를 함께 서빙할지 (운영 이미지 true, 개발은 Vite dev 서버)
WF_SERVE_WEB=false
WF_WEB_DIST=../web/dist

# --- Phase 1: 세션·계정 (P1_설계서_Auth 9절) ---
# 세션 쿠키 서명 키. 32자 이상. 바꾸면 기존 세션이 전부 무효가 된다
WF_SESSION_SECRET=change-me-to-a-long-random-string-32chars
WF_SESSION_IDLE_MINUTES=30
WF_SESSION_ABSOLUTE_HOURS=12
# 시드가 만드는 최초 계정. 첫 로그인에서 비밀번호 변경이 강제된다
WF_ROOT_USERNAME=root
WF_ROOT_PASSWORD=change-me-on-first-login

# --- Phase 1: 사내 IdP (OIDC). 끄면 관련 엔드포인트가 404다 ---
WF_OIDC_ENABLED=false
# 실제 값은 .env에만. 문서·예시는 placeholder (CLAUDE.md 12.3절)
WF_OIDC_ISSUER=https://idp.example.internal
WF_OIDC_CLIENT_ID=workfluence
WF_OIDC_CLIENT_SECRET=change-me
WF_OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/oidc/callback
# IdP가 PKCE를 지원하지 않으면 false (보류 1)
WF_OIDC_PKCE=true
# 그룹명 → 역할. 비어 있으면 모든 IdP 사용자가 로그인 거부된다.
# **따옴표로 감싼다** — 감싸지 않으면 이 파일을 `source`할 때 셸이 JSON을 쪼갠다
WF_OIDC_ROLE_MAP='{"wf-admins":"admin","wf-users":"member"}'
# 모의 OIDC 제공자. 운영(production)에서는 스키마가 거부한다
WF_OIDC_MOCK=false

# --- Phase 3: 첨부 (P3_설계서_Content 4절) ---
# 첨부 저장 경로. 파일 이름은 내용 SHA-256이라 사용자 입력이 경로에 닿지 않는다
WF_STORAGE_PATH=.local/attachments
WF_UPLOAD_MAX_MB=20
