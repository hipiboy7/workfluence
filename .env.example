# workfluence 환경변수 — 모든 키는 WF_ 접두사. 스키마: packages/shared/src/env.ts (CLAUDE.md 5절)
# 실제 값은 .env(커밋 금지)에. 여기는 placeholder만 (CLAUDE.md 12.3절)

# 실행 환경: development | test | production
WF_ENV=development
WF_PORT=3000
WF_LOG_LEVEL=info

# PostgreSQL. 개발 PC는 임베디드 PG(pnpm dev:db)가 .local/pgdata에서 아래 포트로 뜬다
WF_DATABASE_URL=postgres://workfluence:workfluence@127.0.0.1:5433/workfluence
WF_DATABASE_URL_TEST=postgres://workfluence:workfluence@127.0.0.1:5433/workfluence_test
# 개발에서만 true 허용. 운영은 pnpm db:migrate를 배포 절차에서 명시 실행 (CLAUDE.md 6절)
WF_DB_AUTO_MIGRATE=true

# 임베디드 PostgreSQL (pnpm dev:db). 데이터는 반드시 D 드라이브 .local/ 아래 (CLAUDE.md 8.1절)
WF_PG_EMBEDDED_DIR=.local/pgdata
WF_PG_EMBEDDED_PORT=5433
WF_PG_EMBEDDED_PASSWORD=workfluence

# 세션 (CLAUDE.md 7절). 시크릿은 32자 이상 무작위 문자열
WF_SESSION_SECRET=<32자 이상 무작위 문자열>
WF_COOKIE_SECURE=false
WF_SESSION_IDLE_MINUTES=30
WF_SESSION_ABSOLUTE_HOURS=12
WF_TRUST_PROXY=false

# 최초 관리자 계정 (pnpm db:seed). 첫 로그인 후 변경
WF_ADMIN_USERNAME=admin
WF_ADMIN_INITIAL_PASSWORD=<12자 이상, 영문·숫자·특수 3종>

# api가 빌드된 SPA를 함께 서빙할지 (운영 이미지 true, 개발은 Vite dev 서버)
WF_SERVE_WEB=false
WF_WEB_DIST=../web/dist
