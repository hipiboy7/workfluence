{
  "name": "@workfluence/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "workfluence 웹 SPA (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "_comment_test": "web은 아직 테스트가 0건이라 --passWithNoTests가 필요하다. 커버리지 관문도 없다 (CLAUDE.md 3절). api에서는 뺐다 — 거기서는 테스트가 사라지면 실패해야 한다",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@workfluence/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
